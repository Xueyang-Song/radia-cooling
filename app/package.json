{
  "name": "radiative-cooling-explorer",
  "private": true,
  "version": "0.1.0",
  "description": "Portable desktop viewer for the radiative cooling project story.",
  "author": "neroc",
  "type": "module",
  "main": "electron/main.cjs",
  "productName": "Radiative Cooling Explorer",
  "scripts": {
    "sync-content": "..\\ml_pipeline\\.venv\\Scripts\\python.exe scripts\\generate_content.py",
    "dev": "npm run sync-content && vite",
    "build:web": "npm run sync-content && tsc -b && vite build",
    "build": "npm run build:web",
    "desktop": "npm run build:web && electron .",
    "dist:portable": "npm run build:web && electron-builder --win portable",
    "dist:portable:dir": "npm run build:web && electron-builder --win portable --dir",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@fontsource/newsreader": "^5.2.10",
    "@fontsource/space-grotesk": "^5.2.10",
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "41.2.1",
    "electron-builder": "26.8.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.14.0",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4"
  },
  "build": {
    "appId": "com.neroc.radiativecooling.explorer",
    "artifactName": "${productName}-${version}-${arch}-portable.${ext}",
    "asar": true,
    "compression": "normal",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "electron/preload.cjs",
      "package.json"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "loadBrowserProcessSpecificV8Snapshot": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "afterPack": "./electron/hooks/afterPack.cjs",
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/assets/hero.png"
    }
  }
}
